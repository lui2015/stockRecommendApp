# 服务端口
PORT=3210

# 腾讯混元大模型接口配置（务必只在服务端使用，切勿下发到前端/写入代码库）
HUNYUAN_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HUNYUAN_API_KEY=请填写你自己申请的密钥，切勿使用示例/他人密钥
HUNYUAN_MODEL=hy3

# 单次大模型请求超时时间（毫秒）。个股深度分析报告内容较多，建议不低于30000
HUNYUAN_TIMEOUT_MS=45000

# 限流配置
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
